{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "RENDERER pass of the `electron` example-verification harness. One pass per process target; a single combined config is a FALSE-PASS harness that certifies exactly the boundary violations this skill exists to prevent. Consumed as the `extends` base by run-examples.sh over units/renderer/; not run standalone.",
  "//boundary": "This pass rejects Node globals (no @types/node -> `process` is TS2591) and EVERY Electron module (the generated renderer view exports nothing -> any `electron` import is TS2305). A correctly built renderer reaches the main process only through the contextBridge API its preload exposed.",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "target": "ES2023",

    // The renderer is a web page: DOM yes, Node no.
    "lib": ["ES2023", "DOM"],
    // No @types/node. A renderer example touching `process` or `__dirname` must
    // fail with TS2591 — that is the ambient guard.
    "types": [],
    // The bare specifier `electron` resolves to the RENDERER view, whose module
    // surface is deliberately empty, so ANY `electron` import is TS2305. With
    // `contextIsolation` on (the default since 12.0.0) a renderer cannot reach
    // the Electron modules at all, so an example that imports one is wrong.
    "paths": { "electron": ["./generated/electron-renderer.d.ts"] },

    // REQUIRED, not an inherited convenience. `electron.d.ts` is one monolithic
    // declaration carrying both main and renderer types, and it references DOM
    // types (HTMLElement, VideoFrame, MessagePort,
    // EventListenerOrEventListenerObject). Under a DOM-free config it emits ~13
    // errors INSIDE Electron's own typings before the compiler reaches a single
    // example. The renderer pass keeps the flag with the other two so all three
    // passes fail and pass for the same reasons.
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "isolatedModules": true,
    "esModuleInterop": true,

    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,

    // Relaxed so a teaching snippet may declare a value only to show its type.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
