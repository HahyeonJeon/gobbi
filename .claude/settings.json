{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Skill(gobbi)",
      "Skill(gobbi:agent-teams)",
      "Skill(gobbi:partner)",
      "Skill(gobbi:gobbi-setup)",
      "Skill(gobbi-setup)",
      "Skill(cowork)",
      "Skill(workflow)",
      "Skill(git)",
      "Skill(principles)",
      "Skill(delegation)",
      "Skill(discussion)",
      "Skill(evaluation)",
      "Skill(execution)",
      "Skill(ideation)",
      "Skill(startup)",
      "Skill(memory)",
      "Skill(planning)",
      "Skill(study)",
      "Skill(wrap-up)",
      "Agent(manager)",
      "Agent(developer)",
      "Agent(designer)",
      "Agent(author)",
      "Agent(assistant)",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.gobbi/projects/gobbi/hooks/stop-remind.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
