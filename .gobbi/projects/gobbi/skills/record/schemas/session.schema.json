{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobbi.dev/schemas/session-v5.json",
  "title": "Gobbi session manifest version 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "project",
    "feature",
    "task",
    "runtime",
    "startedAt",
    "finishedAt",
    "git",
    "settings",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {"const": 5},
    "sessionId": {"type": "string", "format": "uuid"},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "feature": {"$ref": "#/$defs/nullableIdentity"},
    "task": {"$ref": "#/$defs/nullableIdentity"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "git": {"$ref": "#/$defs/git"},
    "settings": {"$ref": "#/$defs/settings"},
    "outcome": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/outcome"}
      ]
    }
  },
  "$defs": {
    "nullableIdentity": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F]+$"
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "ids"],
      "properties": {
        "system": {"enum": ["claude-code", "codex"]},
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "nullableNumber": {
      "anyOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 1}
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "baseBranch",
        "branch",
        "worktreePath",
        "issue",
        "pullRequest"
      ],
      "properties": {
        "repo": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "baseBranch": {"$ref": "#/$defs/gitName"},
        "branch": {"$ref": "#/$defs/gitName"},
        "worktreePath": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2,
          "maxLength": 4096
        },
        "issue": {"$ref": "#/$defs/nullableNumber"},
        "pullRequest": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "gitName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "iterationSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIterations"],
      "properties": {
        "maxIterations": {"type": "integer", "minimum": 1, "maximum": 99}
      }
    },
    "workflowSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ideation", "planning", "execution", "wrap-up"],
      "properties": {
        "ideation": {"$ref": "#/$defs/iterationSetting"},
        "planning": {"$ref": "#/$defs/iterationSetting"},
        "execution": {"$ref": "#/$defs/iterationSetting"},
        "wrap-up": {"$ref": "#/$defs/iterationSetting"}
      }
    },
    "roleModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "leader", "executor", "evaluator", "assistant"],
      "properties": {
        "manager": {"type": "string", "minLength": 1, "maxLength": 128},
        "leader": {"type": "string", "minLength": 1, "maxLength": 128},
        "executor": {"type": "string", "minLength": 1, "maxLength": 128},
        "evaluator": {"type": "string", "minLength": 1, "maxLength": 128},
        "assistant": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "modelSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {"$ref": "#/$defs/roleModels"},
        "codex": {"$ref": "#/$defs/roleModels"}
      }
    },
    "gitSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "createIssue", "draftPullRequest"],
      "properties": {
        "publication": {"enum": ["local", "push", "pull-request"]},
        "createIssue": {"type": "boolean"},
        "draftPullRequest": {"type": "boolean"}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "models", "git"],
      "properties": {
        "workflow": {"$ref": "#/$defs/workflowSettings"},
        "models": {"$ref": "#/$defs/modelSettings"},
        "git": {"$ref": "#/$defs/gitSettings"}
      }
    },
    "stepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "artifact"],
      "properties": {
        "verdict": {"enum": ["PASS", "REVISE", "FAIL"]},
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "nullableStepResult": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/stepResult"}
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "step", "iteration", "decisionArtifact"],
      "properties": {
        "system": {"enum": ["claude", "codex"]},
        "step": {"enum": ["ideation", "planning", "execution", "wrap-up"]},
        "iteration": {"type": "integer", "minimum": 1},
        "decisionArtifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "handoffPath", "waivers", "reason"],
      "properties": {
        "status": {"enum": ["complete", "halted", "aborted"]},
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ideation", "planning", "execution", "wrap-up"],
          "properties": {
            "ideation": {"$ref": "#/$defs/nullableStepResult"},
            "planning": {"$ref": "#/$defs/nullableStepResult"},
            "execution": {"$ref": "#/$defs/nullableStepResult"},
            "wrap-up": {"$ref": "#/$defs/nullableStepResult"}
          }
        },
        "handoffPath": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          ]
        },
        "waivers": {
          "type": "array",
          "items": {"$ref": "#/$defs/waiver"}
        },
        "reason": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 2000}
          ]
        }
      }
    }
  }
}
