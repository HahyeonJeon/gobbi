{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobbi.dev/schemas/draft-v1.json",
  "title": "Gobbi independent system draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "system",
    "step",
    "iteration",
    "assignment",
    "runtimeIdentity",
    "contractSha256",
    "title",
    "summary",
    "content"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "draft"},
    "system": {"enum": ["claude", "codex"]},
    "step": {"enum": ["ideation", "planning", "execution", "wrap-up"]},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 99},
    "assignment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "runtimeIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "contractSha256": {"$ref": "#/$defs/sha256"},
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "summary": {"$ref": "#/$defs/nonEmptyText"},
    "content": {"$ref": "#/$defs/nonEmptyText"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "pattern": "\\S"
    }
  }
}
