{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobbi.dev/schemas/cross-review-v1.json",
  "title": "Gobbi reciprocal cross-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "system",
    "step",
    "iteration",
    "assignment",
    "runtimeIdentity",
    "contractSha256",
    "subjectSystem",
    "subjectSha256",
    "conclusion",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "cross-review"},
    "system": {"enum": ["claude", "codex"]},
    "step": {"enum": ["ideation", "planning", "execution", "wrap-up"]},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 99},
    "assignment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "runtimeIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "contractSha256": {"$ref": "#/$defs/sha256"},
    "subjectSystem": {"enum": ["claude", "codex"]},
    "subjectSha256": {"$ref": "#/$defs/sha256"},
    "conclusion": {"enum": ["accept", "revise"]},
    "summary": {"$ref": "#/$defs/nonEmptyText"},
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/reviewFinding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"system": {"const": "claude"}}},
      "then": {"properties": {"subjectSystem": {"const": "codex"}}}
    },
    {
      "if": {"properties": {"system": {"const": "codex"}}},
      "then": {"properties": {"subjectSystem": {"const": "claude"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "pattern": "\\S"
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "evidence", "recommendation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
        },
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "evidence": {"$ref": "#/$defs/nonEmptyText"},
        "recommendation": {"$ref": "#/$defs/nonEmptyText"}
      }
    }
  }
}
