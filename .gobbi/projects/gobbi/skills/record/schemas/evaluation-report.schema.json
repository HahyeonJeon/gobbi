{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobbi.dev/schemas/evaluation-report-v1.json",
  "title": "Gobbi complete system evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "system",
    "step",
    "iteration",
    "assignment",
    "runtimeIdentity",
    "subjectSha256",
    "perspectives",
    "overall",
    "checklist",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "evaluation-report"},
    "system": {"enum": ["claude", "codex"]},
    "step": {"enum": ["ideation", "planning", "execution", "wrap-up"]},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 99},
    "assignment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "runtimeIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "subjectSha256": {"$ref": "#/$defs/sha256"},
    "perspectives": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Project"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Structure"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Performance"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Aesthetics"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Usage"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Consistency"}}}]},
        {"allOf": [{"$ref": "#/$defs/perspective"}, {"properties": {"name": {"const": "Risk"}}}]}
      ],
      "items": false
    },
    "overall": {"$ref": "#/$defs/overall"},
    "checklist": {
      "type": "array",
      "minItems": 8,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/check"}
    },
    "verdict": {"$ref": "#/$defs/verdict"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "pattern": "\\S"
    },
    "verdict": {"enum": ["PASS", "REVISE", "FAIL"]},
    "perspectiveName": {
      "enum": [
        "Project",
        "Structure",
        "Performance",
        "Aesthetics",
        "Usage",
        "Consistency",
        "Risk",
        "Overall"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "runtimeIdentity", "findingId"],
      "properties": {
        "system": {"enum": ["claude", "codex"]},
        "runtimeIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "findingId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "perspective",
        "type",
        "domain",
        "disposition",
        "confidence",
        "severity",
        "symptom",
        "rootCause",
        "evidence",
        "falsePositiveCheck",
        "recommendation",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
        },
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "perspective": {"$ref": "#/$defs/perspectiveName"},
        "type": {
          "enum": ["scenario_gap", "checklist_gap", "design_flaw", "assumption_risk", "general"]
        },
        "domain": {
          "enum": [
            "security",
            "performance",
            "test",
            "observability",
            "privacy",
            "compliance",
            "dependency",
            "docs-sync",
            "cost",
            "accessibility",
            "i18n",
            "unevaluable",
            "step-mismatch",
            "regression",
            "process",
            "general"
          ]
        },
        "disposition": {"enum": ["open", "addressed", "disputed", "deferred", "superseded"]},
        "confidence": {"enum": [0, 25, 50, 75, 100]},
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "symptom": {"$ref": "#/$defs/nonEmptyText"},
        "rootCause": {"$ref": "#/$defs/nonEmptyText"},
        "evidence": {"$ref": "#/$defs/nonEmptyText"},
        "falsePositiveCheck": {"$ref": "#/$defs/nonEmptyText"},
        "recommendation": {"$ref": "#/$defs/nonEmptyText"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "findings", "verdict"],
      "properties": {
        "name": {"$ref": "#/$defs/perspectiveName"},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "findings": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/finding"}
        },
        "verdict": {"$ref": "#/$defs/verdict"}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "preserve", "verdict"],
      "properties": {
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "findings": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/finding"}
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "verdict": {"$ref": "#/$defs/verdict"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "perspective", "description", "status", "evidence", "findingIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,95}$"
        },
        "perspective": {"$ref": "#/$defs/perspectiveName"},
        "description": {"$ref": "#/$defs/nonEmptyText"},
        "status": {"enum": ["PASS", "FAIL", "N/A"]},
        "evidence": {"$ref": "#/$defs/nonEmptyText"},
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
          }
        }
      }
    }
  }
}
