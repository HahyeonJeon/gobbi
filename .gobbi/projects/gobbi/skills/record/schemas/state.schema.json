{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobbi.dev/schemas/state-v3.json",
  "title": "Gobbi workflow router version 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "current",
    "completedSteps",
    "completedTasks",
    "lastVerdict",
    "activeDispatches"
  ],
  "properties": {
    "schemaVersion": {"const": 3},
    "status": {"enum": ["active", "halted", "complete"]},
    "current": {"$ref": "#/$defs/current"},
    "completedSteps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/step"}
    },
    "completedTasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      }
    },
    "lastVerdict": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["PASS", "REVISE", "FAIL"]}
      ]
    },
    "activeDispatches": {
      "type": "array",
      "items": {"$ref": "#/$defs/dispatch"}
    }
  },
  "$defs": {
    "step": {
      "enum": ["configuration", "ideation", "planning", "execution", "wrap-up"]
    },
    "stage": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["DISCUSSION", "WORK", "EVALUATION", "RECORD"]}
      ]
    },
    "task": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        }
      ]
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "stage", "iteration", "task"],
      "properties": {
        "step": {"$ref": "#/$defs/step"},
        "stage": {"$ref": "#/$defs/stage"},
        "iteration": {"type": "integer", "minimum": 1},
        "task": {"$ref": "#/$defs/task"}
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "system", "kind", "runtimeIdentity", "assignment", "status"],
      "properties": {
        "role": {"enum": ["leader", "executor", "evaluator", "assistant"]},
        "system": {"enum": ["claude", "codex"]},
        "kind": {"enum": ["teammate", "fresh-agent", "peer-cli"]},
        "runtimeIdentity": {"type": "string", "minLength": 1, "maxLength": 256},
        "assignment": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
        },
        "status": {"enum": ["assigned", "running", "reported", "idle"]}
      }
    }
  }
}
