{
  "schemaVersion": 1,
  "mode": "chat",
  "workflow": {
    "ideation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    },
    "preparation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": true,
      "maxIterations": 0
    },
    "planning": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 1
    },
    "execution": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 3
    },
    "wrap-up": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 3
    }
  },
  "models": {
    "claude": {
      "manager":   "opus",
      "leader":    "opus",
      "executor":  "opus",
      "evaluator": "opus",
      "assistant": "sonnet"
    },
    "codex": {
      "manager":   "gpt-5.6-sol",
      "leader":    "gpt-5.6-sol",
      "executor":  "gpt-5.6-sol",
      "evaluator": "gpt-5.6-sol",
      "assistant": "gpt-5.6-sol"
    }
  },
  "git": {
    "repo":       null,
    "baseBranch": null,
    "pr":       { "open": false, "draft": false },
    "issue":    { "create": false },
    "worktree": { "autoRemove": true },
    "branch":   { "autoRemove": true }
  },
  "compaction": {
    "enabled": false,
    "maxAutoActions": 3,
    "note": "`enabled` gates ONLY automatic merging and ships false (dormant); it does NOT gate counting, terminal archival, the `hardCap` check, or the Always-Ask decision. Wrap-up always counts every {type}/{area}/ area post-promotion and an over-`hardCap` area cannot silently PASS (routes to Always-Ask) regardless of this flag. `maxAutoActions` bounds automatic merges. Per-area softCap/hardCap (and any per-type override) live in memory/memory-vocabulary.json; the rule is memory/rules.md § 5 and the procedure is skills/wrap-up/compaction.md."
  }
}
