{
  "schemaVersion": 1,
  "mode": "auto",
  "workflow": {
    "ideation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "skip": false,
      "maxIterations": 5
    },
    "preparation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "skip": false,
      "maxIterations": 5
    },
    "planning": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "skip": false,
      "maxIterations": 5
    },
    "execution": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "skip": false,
      "maxIterations": 5
    },
    "wrap-up": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "skip": false,
      "maxIterations": 5
    }
  },
  "agents": {
    "manager":   { "claude": { "model": "fable",  "effort": "xhigh" }, "codex": { "model": "gpt-5.5", "effort": "xhigh" } },
    "leader":    { "claude": { "model": "fable",  "effort": "xhigh" }, "codex": { "model": "gpt-5.5", "effort": "xhigh" } },
    "executor":  { "claude": { "model": "fable",  "effort": "xhigh" }, "codex": { "model": "gpt-5.5", "effort": "xhigh" } },
    "evaluator": { "claude": { "model": "fable",  "effort": "xhigh" }, "codex": { "model": "gpt-5.5", "effort": "xhigh" } },
    "assistant": { "claude": { "model": "sonnet", "effort": "high" }, "codex": { "model": "gpt-5",   "effort": "high" } }
  },
  "git": {
    "repo":       null,
    "baseBranch": null,
    "pr":       { "open": false, "draft": false },
    "issue":    { "create": false },
    "worktree": { "autoRemove": true },
    "branch":   { "autoRemove": true }
  }
}
