{
  "schemaVersion": 1,
  "mode": "auto",
  "workflow": {
    "ideation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    },
    "preparation": {
      "discuss":  { "mode": "user" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    },
    "planning": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    },
    "execution": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    },
    "wrap-up": {
      "discuss":  { "mode": "agent" },
      "evaluate": { "mode": "always" },
      "propose":  { "mode": "dual" },
      "skip": false,
      "maxIterations": 5
    }
  },
  "models": {
    "claude": {
      "manager":   "opus",
      "leader":    "opus",
      "executor":  "opus",
      "evaluator": "opus",
      "assistant": "sonnet"
    },
    "codex": {
      "manager":   "gpt-5.6-sol",
      "leader":    "gpt-5.6-sol",
      "executor":  "gpt-5.6-sol",
      "evaluator": "gpt-5.6-sol",
      "assistant": "gpt-5.6-sol"
    }
  },
  "git": {
    "repo":       null,
    "baseBranch": null,
    "pr":       { "open": false, "draft": false },
    "issue":    { "create": false },
    "worktree": { "autoRemove": true },
    "branch":   { "autoRemove": true }
  },
  "compaction": {
    "enabled": false,
    "maxAutoActions": 3
  }
}
