import re
root=Path('.').resolve()
project=root/'.gobbi/projects/gobbi'
feature=project/'features/git-workflow'
skills=project/'skills'
files=[Path(p.strip()) for p in '''.gobbi/projects/gobbi/features/git-workflow/README.md
