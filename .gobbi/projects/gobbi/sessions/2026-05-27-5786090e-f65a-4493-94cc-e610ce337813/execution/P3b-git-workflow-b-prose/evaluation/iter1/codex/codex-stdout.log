# Patterns: markdown links, inline-code path-ish md, bare session/feature path mentions.
mdlink=re.compile(r'\\[["'^'"\\]]+\\]\\((["'^)]+)'"\\)')
codepath=re.compile(r'"'`([''^`'"\\n]*\\.md(?:#["'^`'"\\n]*)?)"'`'"')
bare=re.compile(r'(?<"'!['"\\w/.-])((?:sessions|features|\\.claude|\\.agents|\\.gobbi|git|orchestration|delegation|preparation|gobbi)/["'^'"\\s)"'`:;,]+'"\\.md(?:#["'^'"\\s)"'`;,]+)?)'"')
ignored_schemes=('http://','https://','mailto:')
refs=[]
for f in files:
    text=f.read_text()
    for i,line in enumerate(text.splitlines(),1):
        vals=[]
        vals += [m.group(1) for m in mdlink.finditer(line)]
        vals += [m.group(1) for m in codepath.finditer(line)]
        vals += [m.group(1) for m in bare.finditer(line) if m.group(1) not in vals]
        for val in vals:
            target=val.strip().split('#',1)[0]
            if not target or target.startswith(ignored_schemes):
                continue
            # skip placeholders and shell globs
            if '<' in target or '>' in target or '*' in target or '{' in target or '}' in target:
                continue
            refs.append((f,i,target,line.strip()))

def candidates(f,t):
    p=Path(t)
    if p.is_absolute():
        return [p]
    return [
        (f.parent/p),
        (feature/p),
        (project/p),
        (skills/p),
        (root/p),
    ]

seen=set()
missing=[]
resolved=[]
for f,i,t,line in refs:
    key=(str(f),i,t)
    if key in seen: continue
    seen.add(key)
    cands=candidates(f,t)
    hit=next((c for c in cands if c.exists()),None)
    if hit:
        resolved.append((f,i,t,hit))
    else:
        missing.append((f,i,t,line,cands))
print(f\"refs checked: {len(resolved)+len(missing)}\")
print(f\"resolved: {len(resolved)}\")
print(f\"missing: {len(missing)}\")
for f,i,t,line,cands in missing:
    print(f\"MISSING {f}:{i}: {t}\")
    print(f\"  line: {line}\")
