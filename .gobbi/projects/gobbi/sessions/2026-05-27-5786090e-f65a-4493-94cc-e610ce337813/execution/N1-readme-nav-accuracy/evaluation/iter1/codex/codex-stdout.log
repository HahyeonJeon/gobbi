.gobbi/projects/gobbi/features/workflow/decisions/wrap-up-step-2-5-anchor-placement.md:4:type: decisions
.gobbi/projects/gobbi/features/workflow/decisions/wrap-up-step-2-5-anchor-placement.md:5:scope: feature
