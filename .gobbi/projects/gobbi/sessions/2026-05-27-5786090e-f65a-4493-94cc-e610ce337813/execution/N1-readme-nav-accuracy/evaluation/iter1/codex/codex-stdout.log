.gobbi/projects/gobbi/features/agents/references/langgraph-skill-catalog-pattern.md:4:type: references
.gobbi/projects/gobbi/features/agents/references/langgraph-skill-catalog-pattern.md:5:scope: feature
.gobbi/projects/gobbi/features/agents/references/langgraph-skill-catalog-pattern.md:6:feature: agents
.gobbi/projects/gobbi/features/agents/references/langgraph-skill-catalog-pattern.md:7:status: active
