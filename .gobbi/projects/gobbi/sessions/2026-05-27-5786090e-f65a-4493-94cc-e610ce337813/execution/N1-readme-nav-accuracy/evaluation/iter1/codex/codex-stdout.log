from pathlib import Path
import glob, re
root = Path('.')
readmes = [
'.gobbi/projects/gobbi/README.md',
'.gobbi/projects/gobbi/features/README.md',
'.gobbi/projects/gobbi/features/agents/README.md',
'.gobbi/projects/gobbi/features/evaluation/README.md',
'.gobbi/projects/gobbi/features/git-workflow/README.md',
'.gobbi/projects/gobbi/features/guardrails/README.md',
'.gobbi/projects/gobbi/features/install-runtime/README.md',
'.gobbi/projects/gobbi/features/project-memory/README.md',
'.gobbi/projects/gobbi/features/workflow/README.md',
'.gobbi/projects/gobbi/backlogs/README.md',
'.gobbi/projects/gobbi/decisions/README.md',
'.gobbi/projects/gobbi/design/README.md',
'.gobbi/projects/gobbi/learnings/README.md',
'.gobbi/projects/gobbi/mistakes/README.md',
'.gobbi/projects/gobbi/notes/README.md',
'.gobbi/projects/gobbi/plans/README.md',
'.gobbi/projects/gobbi/references/README.md',
'.gobbi/projects/gobbi/reviews/README.md',
]

def subdir_section(text):
    m = re.search(r'"'^## Subdirectories'"\\s*"'$'"', text, re.M)
    if not m:
        return None
    rest = text[m.end():]
    n = re.search(r'"'^##'"\\s+', rest, re.M)
    return rest[:n.start()] if n else rest

def listed_entries(section):
    if section is None:
        return None, False
    names = []
    none = False
    for line in section.splitlines():
        stripped = line.strip()
        if not stripped.startswith('-'):
            continue
        if re.search(r'\\bNone\\b|_None', stripped, re.I):
            none = True
        m = re.search(r'"'`([''^`]+/)`'"', stripped)
        if m:
            names.append(m.group(1).rstrip('/'))
    return sorted(set(names)), none

bad = []
for p in readmes:
    path = root/p
    text = path.read_text()
    d = path.parent
    live = sorted(Path(x).name for x in glob.glob(str(d) + '/*/'))
    section = subdir_section(text)
    listed, none = listed_entries(section)
    if listed is None:
        status = 'MISSING_SECTION'
        missing = live
        extra = []
    elif live:
        missing = sorted(set(live)-set(listed))
        extra = sorted(set(listed)-set(live))
        status = 'OK' if not missing and not extra and not none else 'BAD'
    else:
        missing = []
        extra = sorted(set(listed)) if listed else []
        status = 'OK' if none and not extra else 'BAD'
    if status "'!= '"'OK':
        bad.append((p,status,live,listed,none,missing,extra))
    print(f\"{p}\\n  live:   {live if live else ['_None_']}\\n  listed: {listed if listed else (['_None_'] if none else [])}\\n  status: {status}\")
    if missing or extra:
        print(f\"  missing: {missing}\\n  extra:   {extra}\")
if bad:
    print('\\nMISMATCHES:', len(bad))
    for item in bad:
        print(item)
    raise SystemExit(1)
print('\\nAll README Subdirectories sections match live subdirs.')
