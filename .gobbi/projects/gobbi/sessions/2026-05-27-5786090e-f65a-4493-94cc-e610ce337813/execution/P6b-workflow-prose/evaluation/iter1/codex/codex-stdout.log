from pathlib import Path
import re, os
root=Path('.').resolve()
files=[Path(p) for p in os.popen(\"git show --name-only --format= fddc040 -- .gobbi/projects/gobbi/features/workflow\").read().splitlines() if p]
patterns=[re.compile(r'\\[["'^'"\\]]+\\]\\((["'^)]+)'"\\)'), re.compile(r'"'`([''^`'"\\n]+\\.md(?:#["'^`'"\\n]+)?)"'`'"')]
missing=[]
checked=[]
for f in files:
    txt=f.read_text()
    for pat in patterns:
        for m in pat.finditer(txt):
            raw=m.group(1).strip()
            if raw.startswith(('http://','https://','mailto:','#')):
                continue
            target=raw.split('#',1)[0]
            if not target or any(ch in target for ch in ['*','{','}']):
                continue
            # skip bare filenames without slash? check them relative too
            p=Path(target)
            if p.is_absolute():
                exists=p.exists()
            else:
                exists=(f.parent/p).exists()
            checked.append((str(f), raw, exists, str((f.parent/p).resolve()) if not p.is_absolute() else str(p)))
            if not exists:
                missing.append((str(f), raw, str((f.parent/p).resolve()) if not p.is_absolute() else str(p)))
print('checked', len(checked))
if missing:
    for x in missing:
        print('MISSING', x[0], '->', x[1], '=>', x[2])
else:
    print('MISSING none')
