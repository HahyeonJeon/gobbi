   122	#   step / phase    ← tool_input.prompt structured headers
   123	#   iter / sub-step ← tool_input.prompt structured headers
   124	# Headers convention: `^Your (phase|iteration|sub-step|step): (.+)$`.
   125	# ---------------------------------------------------------------------------
   126	prompt_text=$(jq -r '.tool_input.prompt // ""' <<<"$payload")
   127	model=$(jq -r       '.tool_input.model  // ""' <<<"$payload")
   128	subagent_type=$(jq -r '.tool_input.subagent_type // ""' <<<"$payload")
   129	
   130	extract_header() {
   131	    # $1 = key (phase|iteration|step|sub-step). Match case-insensitively.
   132	    local _key="$1"
   133	    printf '%s\n' "$prompt_text" \
   134	        | grep -m1 -iE "^Your[[:space:]]+${_key}:[[:space:]]+.+" \
   135	        | sed -E "s/^Your[[:space:]]+${_key}:[[:space:]]+//I" \
   136	        | head -c 200 || true
   137	}
   138	
   139	step=$(extract_header "step")
   140	phase=$(extract_header "phase")
   141	iter=$(extract_header "iteration")
   142	sub_step=$(extract_header "sub-step")
   143	
   144	# ---------------------------------------------------------------------------
   145	# Two-tier extraction of result-side telemetry (D-3-1, D-3-6).
   146	# Tier 1 (preferred): rich `toolUseResult` from the transcript JSONL,
   147	#                     correlated by tool_use_id.
   148	# Tier 2 (fallback): the documented `tool_result` already on stdin.
   149	# Failure event has no useful result payload — synthesize a "failed" record.
   150	# ---------------------------------------------------------------------------
   151	tier1=""
   152	if [[ -n "$transcript_path" && -f "$transcript_path" ]]; then
   153	    # Last matching line wins (retries supersede earlier attempts).
   154	    tier1=$(jq -c --arg tuid "$tool_use_id" '
   155	        select(.toolUseResult != null)
   156	        | select(
   157	            (.message.content[]?.tool_use_id // empty) == $tuid
   158	            or (.toolUseResult.agentId // empty) != null
   159	              and ((.message.content[]?.tool_use_id // empty) == $tuid)
   160	          )
   161	    ' "$transcript_path" 2>/dev/null | tail -n1 || true)
   162	fi
   163	
   164	# Compose the upsert input JSON for the jq pipeline.
   165	status="ok"
   166	[[ "$hook_event" == "PostToolUseFailure" ]] && status="failed"
   167	
   168	upsert_input=$(jq -n \
   169	    --arg tuid     "$tool_use_id" \
   170	    --arg model    "$model" \
   171	    --arg step     "$step" \
   172	    --arg phase    "$phase" \
   173	    --arg iter     "$iter" \
   174	    --arg sub_step "$sub_step" \
   175	    --arg sub_type "$subagent_type" \
   176	    --arg status   "$status" \
   177	    --arg event    "$hook_event" \
   178	    --argjson tier1 "${tier1:-null}" \
   179	    --argjson tier2 "$(jq -c '.tool_result // null' <<<"$payload")" \
   180	    '
   181	    # Pick agentId/agentType/usage from tier1 (toolUseResult) when present;
   182	    # fall back to tier2 (tool_result) shape; finally synthesize from tuid.
   183	    ($tier1.toolUseResult // {})                       as $r1
   184	    | ($tier2 // {})                                   as $r2
   185	    | (($r1.agentId   // $r2.agentId   // null))       as $aid
   186	    | (($r1.agentType // $r2.agentType // $sub_type))  as $atype
   187	    | (($r1.usage     // $r2.usage     // {}))         as $usage
   188	    | (($r1.totalDurationMs // null))                  as $dur
   189	    | {
   190	        id:        ($aid // $tuid),
   191	        tool_use_id: $tuid,
   192	        name:      ($atype // null),
   193	        type:      ($atype // null),
   194	        step:      (if $step     == "" then null else $step     end),
   195	        phase:     (if $phase    == "" then null else $phase    end),
   196	        iter:      (if $iter     == "" then null else $iter     end),
   197	        sub_step:  (if $sub_step == "" then null else $sub_step end),
   198	        model:     (if $model    == "" then null else $model    end),
   199	        status:    $status,
   200	        hook_event: $event,
   201	        transcriptPath: null,
   202	        tokensUsed: {
   203	          input:         ($usage.input_tokens                // 0),
   204	          output:        ($usage.output_tokens               // 0),
   205	          cacheRead:     ($usage.cache_read_input_tokens     // 0),
   206	          cacheCreation: ($usage.cache_creation_input_tokens // 0)
   207	        },
   208	        totalDurationMs: $dur,
   209	        finishedAt: (now | todate)
   210	      }
   211	    ')
   212	
   213	# ---------------------------------------------------------------------------
   214	# D-3-5 — flock-serialized read-modify-write with atomic mv.
   215	# ---------------------------------------------------------------------------
   216	lock_file="$session_json.lock"
   217	tmp_file="$session_json.tmp.$$"
   218	
   219	(
   220	    flock -x 9 || { log "flock failed on $lock_file"; exit 0; }
   221	
   222	    # upsert by id; first-write-wins for `id` + `startedAt`; last-write-wins
   223	    # for everything else (retries supersede). Preserve unknown fields.
   224	    if ! jq --argjson new "$upsert_input" '
   225	        .agents = (
   226	            (.agents // [])
   227	            | (map(.id) | index($new.id)) as $idx
   228	            | if $idx == null
   229	              then . + [ $new + { startedAt: ($new.finishedAt) } ]
   230	              else (.[$idx] | (.startedAt // $new.finishedAt)) as $kept_started
   231	                   | .[0:$idx]
   232	                     + [ .[$idx] + $new + { startedAt: $kept_started } ]
   233	                     + .[$idx+1:]
   234	              end
   235	        )
   236	    ' "$session_json" > "$tmp_file"; then
   237	        log "jq upsert failed"
   238	        rm -f "$tmp_file"
   239	        exit 0
   240	    fi
   241	
   242	    if ! jq -e . "$tmp_file" >/dev/null 2>&1; then
   243	        log "tmp file failed JSON validation"
   244	        rm -f "$tmp_file"
   245	        exit 0
   246	    fi
   247	
   248	    mv -f "$tmp_file" "$session_json"
   249	) 9>"$lock_file"
   250	
   251	exit 0

