    45	tool_use_id=$(jq -r '.tool_use_id // ""'    <<<"$payload")
    46	hook_event=$(jq -r '.hook_event_name // ""' <<<"$payload")
    47	session_id=$(jq -r '.session_id // ""'      <<<"$payload")
    48	cwd=$(jq -r '.cwd // ""'                    <<<"$payload")
    49	transcript_path=$(jq -r '.transcript_path // ""' <<<"$payload")
    50	
    51	# Scope: only subagent-spawn tool fires. Claude Code presently surfaces the
    52	# Task tool under tool_name "Agent" (empirically 2026-05-23 transcripts);
    53	# the public docs and ideation refer to "Task". Accept both for forward and
    54	# backward compatibility — other PostToolUse events are no-ops.
    55	case "$tool_name" in
    56	    Task|Agent) ;;
    57	    *) exit 0 ;;
    58	esac
    59	[[ -n "$tool_use_id" ]]      || bail "missing tool_use_id"
    60	[[ -n "$session_id" ]]       || bail "missing session_id"
    61	[[ -n "$cwd" ]]              || bail "missing cwd"
    62	
    63	# ---------------------------------------------------------------------------
    64	# D-3-3-resolver — derive session.json path from (session_id, cwd).
    65	# Step (i) DORMANT: read `.gobbi/project.json` if it exists (currently absent).
    66	# Step (ii) ACTIVE: scan `.gobbi/projects/` for a single project directory.
    67	# ---------------------------------------------------------------------------
    68	resolve_project_name() {
    69	    local _cwd="$1"
    70	    # Step (i) — DORMANT. Honored when the file materializes.
    71	    local pjson="$_cwd/.gobbi/project.json"
    72	    if [[ -f "$pjson" ]]; then
    73	        local _name
    74	        _name=$(jq -r '.name // empty' "$pjson" 2>/dev/null || true)
    75	        if [[ -n "$_name" ]]; then
    76	            printf '%s' "$_name"
    77	            return 0
    78	        fi
    79	    fi
    80	    # Step (ii) — directory scan; require exactly one project.
    81	    local projects_dir="$_cwd/.gobbi/projects"
    82	    [[ -d "$projects_dir" ]] || { log "resolver: $projects_dir absent"; return 1; }
    83	    local dirs=()
    84	    local d
    85	    for d in "$projects_dir"/*/; do
    86	        [[ -d "$d" ]] && dirs+=("$d")
    87	    done
    88	    local n=${#dirs[@]}
    89	    if [[ $n -ne 1 ]]; then
    90	        log "session-dir resolver: cannot disambiguate project name (n=$n)"
    91	        return 1
    92	    fi
    93	    basename "${dirs[0]}"
    94	}
    95	
    96	resolve_session_dir() {
    97	    local _cwd="$1" _project="$2" _sid="$3"
    98	    local sessions_dir="$_cwd/.gobbi/projects/$_project/sessions"
    99	    [[ -d "$sessions_dir" ]] || { log "resolver: $sessions_dir absent"; return 1; }
   100	    local matches=()
   101	    local d
   102	    for d in "$sessions_dir"/*-"$_sid"; do
   103	        [[ -d "$d" ]] && matches+=("$d")
   104	    done
   105	    local n=${#matches[@]}
   106	    if [[ $n -ne 1 ]]; then
   107	        log "session-dir resolver: cannot disambiguate session dir (n=$n)"
   108	        return 1
   109	    fi
   110	    printf '%s' "${matches[0]}"
   111	}
   112	
   113	project_name=$(resolve_project_name "$cwd")       || bail "resolver failed (project)"
   114	session_dir=$(resolve_session_dir "$cwd" "$project_name" "$session_id") \
   115	    || bail "resolver failed (session dir)"
   116	session_json="$session_dir/session.json"
   117	[[ -f "$session_json" ]] || bail "session.json not found at $session_json"
   118	
   119	# ---------------------------------------------------------------------------
   120	# Extract input-side metadata (D-3-4).

