     1	#!/usr/bin/env bash
     2	# SessionStart hook — persists Claude Code hook-only env vars to $CLAUDE_ENV_FILE.
     3	#
     4	# Claude Code pipes a JSON object to stdin on every SessionStart event
     5	# (startup / resume / clear / compact).  This script reads that payload and
     6	# appends shell-safe `export VAR=value` lines to $CLAUDE_ENV_FILE so that
     7	# subsequent Bash subprocesses (tool calls, subagents) can read the vars.
     8	#
     9	# Values are serialized via `jq -r @sh` (POSIX-shell single-quote quoting)
    10	# so sourcing the env file is robust against paths with spaces, single quotes,
    11	# shell metacharacters, empty strings, and Unicode.  (FIX C)
    12	#
    13	# Exported vars:
    14	#   REQUIRED (always present in stdin JSON):
    15	#     session_id        -> CLAUDE_CODE_SESSION_ID  (NOT CLAUDE_SESSION_ID — FIX 1)
    16	#     transcript_path   -> CLAUDE_TRANSCRIPT_PATH
    17	#     cwd               -> CLAUDE_CWD
    18	#     hook_event_name   -> CLAUDE_HOOK_EVENT_NAME
    19	#     source            -> CLAUDE_HOOK_SOURCE       (FIX 5; distinct from hook_event_name)
    20	#   OPTIONAL (emitted only when present and non-null in stdin JSON):
    21	#     agent_id          -> CLAUDE_AGENT_ID
    22	#     agent_type        -> CLAUDE_AGENT_TYPE
    23	#     permission_mode   -> CLAUDE_PERMISSION_MODE
    24	#   PASSTHROUGH (re-exported only if already set in this process's env):
    25	#     CLAUDE_PROJECT_DIR, CLAUDE_PLUGIN_ROOT, CLAUDE_PLUGIN_DATA
    26	
    27	set -euo pipefail
    28	
    29	# ---------------------------------------------------------------------------
    30	# Guard: $CLAUDE_ENV_FILE must be set and writable.
    31	# ---------------------------------------------------------------------------
    32	if [[ -z "${CLAUDE_ENV_FILE:-}" ]]; then
    33	    printf '%s\n' "session-start.sh: \$CLAUDE_ENV_FILE is unset — cannot persist env vars" >&2
    34	    exit 1
    35	fi
    36	
    37	if ! touch "${CLAUDE_ENV_FILE}" 2>/dev/null; then
    38	    printf '%s\n' "session-start.sh: \$CLAUDE_ENV_FILE ('${CLAUDE_ENV_FILE}') is not writable" >&2
    39	    exit 1
    40	fi
    41	
    42	# ---------------------------------------------------------------------------
    43	# Read stdin JSON payload.
    44	# ---------------------------------------------------------------------------
    45	payload="$(cat)"
    46	[[ -n "$payload" ]] || { printf '%s\n' "session-start.sh: empty stdin — expected JSON payload" >&2; exit 1; }
    47	
    48	# ---------------------------------------------------------------------------
    49	# REQUIRED fields — always present; emit one export line each via @sh.
    50	# ---------------------------------------------------------------------------
    51	jq -r '@sh "export CLAUDE_CODE_SESSION_ID=\(.session_id)"'    <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    52	jq -r '@sh "export CLAUDE_TRANSCRIPT_PATH=\(.transcript_path)"' <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    53	jq -r '@sh "export CLAUDE_CWD=\(.cwd)"'                        <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    54	jq -r '@sh "export CLAUDE_HOOK_EVENT_NAME=\(.hook_event_name)"' <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    55	jq -r '@sh "export CLAUDE_HOOK_SOURCE=\(.source)"'              <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    56	
    57	# ---------------------------------------------------------------------------
    58	# OPTIONAL fields — emit only when present and non-null in the payload.
    59	# ---------------------------------------------------------------------------
    60	jq -r 'if .agent_id != null then @sh "export CLAUDE_AGENT_ID=\(.agent_id)" else empty end' \
    61	    <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    62	
    63	jq -r 'if .agent_type != null then @sh "export CLAUDE_AGENT_TYPE=\(.agent_type)" else empty end' \
    64	    <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    65	
    66	jq -r 'if .permission_mode != null then @sh "export CLAUDE_PERMISSION_MODE=\(.permission_mode)" else empty end' \
    67	    <<<"$payload" >> "${CLAUDE_ENV_FILE}"
    68	
    69	# ---------------------------------------------------------------------------
    70	# PASSTHROUGH re-exports — re-export only if already in this process's env.
    71	# Uses bash %q for shell-safe quoting (safe here: shebang is bash).
    72	# ---------------------------------------------------------------------------
    73	for _var in CLAUDE_PROJECT_DIR CLAUDE_PLUGIN_ROOT CLAUDE_PLUGIN_DATA; do
    74	    if [[ -n "${!_var:-}" ]]; then
