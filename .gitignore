node_modules/
.claude/project/*/note/
.claude/worktrees/
.claude/.env
.claude/gobbi.json
.claude/gobbi.json.lock

# .gobbi/ — whitelist pattern.
# Ignore workspace-level files (e.g. .gobbi/settings.json, .gobbi/state.db),
# but track per-project content under .gobbi/projects/<name>/ except for
# per-session runtime state (sessions/, rawdata/) and per-project settings.
# `.gobbi/gobbi.db` is the workspace-scoped memories projection
# (Pass-4 orchestration §3.4 + System F-1) — git-tracked so the markdown→
# sqlite read model lives in the repo. `.gobbi/state.db` (events) stays
# under the `.gobbi/*` ignore.
.gobbi/*
!.gobbi/.gitignore
!.gobbi/gobbi.db
!.gobbi/projects/
.gobbi/projects/*/rawdata/
.gobbi/projects/*/sessions/
.gobbi/projects/*/settings.json
.gobbi/projects/*/worktrees/
.gobbi/projects/*/tmp/

dist/
packages/*/dist/
packages/*/node_modules/

# Template-bundle mirror (built by `packages/cli/scripts/sync-template-bundle.ts`
# as the `prepack` hook). Source of truth lives at the workspace-root
# `.gobbi/projects/gobbi/{skills,agents,rules}/`; this copy only exists
# so `npm pack` can ship it inside the tarball.
packages/cli/.gobbi/

# TypeScript example-verification harness (examples/typescript/). The harness
# installs `typescript` as a local devDep to type-check the skill's fenced ts
# examples; its node_modules / bun cache are never committed and must never be
# mirrored into .claude/.agents/plugins. (node_modules/ above already matches
# this by name; these lines are explicit + scoped for the harness surface.)
examples/typescript/node_modules/
examples/typescript/.bun/

# Electron example-verification harness (examples/electron/). Same contract as
# the TypeScript harness above: local devDeps (`typescript`, `electron`,
# `@types/node`) type-check the skill's fenced ts examples once per process
# target. `electron` declares no scripts key, so nothing downloads a binary.
# The derived per-process `electron` views under examples/electron/generated/
# are ignored by that directory's own .gitignore.
examples/electron/node_modules/
examples/electron/.bun/
